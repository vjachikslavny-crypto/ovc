VECTOR_DIM=384
SIMPLE_DB_URL=sqlite:///./src/ovc.db
OFFLINE_MODE=true

# Auth / DB (Postgres)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ovc
DATABASE_URL=sqlite:///./src/ovc.db
SECRET_KEY=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME
ACCESS_TOKEN_EXPIRES_MIN=15
REFRESH_TOKEN_EXPIRES_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=60
RATE_LIMIT_LOGIN_PER_MIN=10
PASSWORD_MIN_LENGTH=8
PASSWORD_MIN_CHARACTER_CLASSES=3
PASSWORD_REQUIRE_UPPER=false
PASSWORD_REQUIRE_LOWER=false
PASSWORD_REQUIRE_DIGIT=false
PASSWORD_REQUIRE_SYMBOL=false
EMAIL_FROM=no-reply@ovc.local
EMAIL_BACKEND=mock

# LLM / Agent
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.4
LLM_CONTEXT_BUDGET=6000
LLM_TIMEOUT_SECONDS=30

# Desktop / auth mode
AUTH_MODE=local
DESKTOP_MODE=false
# Explicit desktop fallback user when no auth token is present.
ALLOW_DESKTOP_DEV_FALLBACK=false

# Optional Supabase (used when AUTH_MODE=supabase or both)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUD=authenticated

# Sync engine (for desktop local-first -> remote sync)
# SYNC_MODE=auto|off|shared-db|remote-sync|remote-shell
SYNC_MODE=auto
SYNC_ENABLED=false
SYNC_REMOTE_BASE_URL=
SYNC_BEARER_TOKEN=
SYNC_POLL_SECONDS=15
SYNC_OUTBOX_MAX=10000
SYNC_BATCH_SIZE=100
SYNC_REQUEST_TIMEOUT_SECONDS=12
SYNC_PULL_ENABLED=true

# Runtime diagnostics / CSP
APP_ENV=development
# Alembic is authoritative. Default: explicit migration before starting the app.
# May be true only for development/test; never auto-repairs legacy corruption.
DB_AUTO_MIGRATE=false
RUNTIME_STATUS_ENABLED=true
CSP_REPORT_ONLY=false
CSP_SCRIPT_SRC_EXTRA=
CSP_STYLE_SRC_EXTRA=
CSP_CONNECT_SRC_EXTRA=
CSP_IMG_SRC_EXTRA=
CSP_FRAME_SRC_EXTRA=

# Public hosting: see docs/stabilization_stage_6.md for the complete HTTPS profile.
# Local defaults below do NOT publish or change the real environment.
PUBLIC_MODE=false
PUBLIC_BASE_URL=
CORS_ORIGINS=
ALLOWED_HOSTS=
# Only the reverse proxy's socket peers; never *. Start uvicorn with --no-proxy-headers.
TRUSTED_PROXY_IPS=
CLOUDFLARED_CONFIG_PATH=

# Stage 6: finite limits PER BACKEND PROCESS (bytes unless stated otherwise).
RUNTIME_WORKERS=4
RUNTIME_JOB_TIMEOUT_SECONDS=150
CONVERSION_TIMEOUT_SECONDS=90
FFMPEG_TIMEOUT_SECONDS=30
LIBREOFFICE_TIMEOUT_SECONDS=60
EXTERNAL_HTTP_TIMEOUT_SECONDS=10
REQUEST_BODY_TIMEOUT_SECONDS=30
SHUTDOWN_GRACE_SECONDS=5
SUBPROCESS_OUTPUT_BYTES=65536
MAX_REQUEST_BYTES=534773760
MAX_FILE_BYTES=209715200
MAX_CONVERSION_BYTES=52428800
MAX_PREVIEW_BYTES=16777216
MAX_ARCHIVE_EXPANDED_BYTES=209715200
MAX_UPLOAD_FILES=10
MAX_AI_CONTEXT_CHARS=100000
STORAGE_MIN_FREE_BYTES=134217728
RATE_LIMIT_UPLOAD_PER_MIN=30
RATE_LIMIT_AI_PER_MIN=30
RATE_LIMIT_SEARCH_PER_MIN=120
RATE_LIMIT_REFRESH_PER_MIN=60
